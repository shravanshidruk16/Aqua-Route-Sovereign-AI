# ============================================================
# AQUAROUTE SOVEREIGN AI - ENVIRONMENT TEMPLATE (.env.example)
# ============================================================
# Copy this file to .env and fill in your secrets before starting.

# --- ACTIVE FRONTIER CLOUD ACCELERATION (GROQ LPU) ---
GROQ_API_KEY=your_groq_api_key_here
NEXT_PUBLIC_GROQ_ENABLED=true

# --- LOCAL SOVEREIGN RUNTIME (OLLAMA) ---
NEXT_PUBLIC_DEFAULT_OLLAMA_HOST=http://localhost:11434

# --- OPTIONAL BACKEND API GATEWAY ---
NEXT_PUBLIC_GATEWAY_API_URL=http://localhost:8000

# --- SOVEREIGN AUDIT & TELEMETRY DATABASE ---
DATABASE_URL=sqlite:///./aquaroute_audit.db

# --- OPTIONAL THIRD-PARTY CLOUD PROVIDER KEYS ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GEMINI_API_KEY=
PERPLEXITY_API_KEY=
